{
  // Language version of C3.
  "langrev": "1",
  // Warnings used for all targets.
  "warnings": [ "no-unused" ],
  // Directories where C3 library files may be found.
  "dependency-search-paths": [ "lib" ],
  // Libraries to use for all targets.
  "dependencies": [ "raylib" ],
  // Authors, optionally with email.
  "authors": [ "Sheldev <sheldev@sheldi.online>" ],
  // Version using semantic versioning.
  "version": "0.1.0",
  // Sources compiled for all targets.
  "sources": [ "src/**" ],
  // Test sources compiled for all targets.
  //"test-sources": [ "test/**" ],
  // C sources if the project also compiles C sources
  // relative to the project file.
  // "c-sources": [ "csource/**" ],
  // Include directories for C sources relative to the project file.
  // "c-include-dirs": [ "csource/include" ],
  // Build location, relative to project file.
  "build-dir": "build",
  // Output location, relative to project file.
  "output": "build",
  // Architecture and OS target.
  // You can use 'c3c --list-targets' to list all valid targets.
  // "target": "windows-x64",
  // Targets.
  "targets": {
    "TerraBlock": {
      // Executable or library.
      "type": "executable"
      // Additional libraries, sources
      // and overrides of global settings here.
    },
    "debug": {
      // Executable or library.
      "type": "executable",
      "opt": "O0"
      // Additional libraries, sources
      // and overrides of global settings here.
    },
    "TerraBlock-freebsd-x64": {
        "type": "executable",
        "target": "freebsd-x64"
    },
    "TerraBlock-linux-aarch64": {
        "type": "executable",
        "target": "linux-aarch64"
    },
    "TerraBlock-linux-x64": {
        "type": "executable",
        "target": "linux-x64"
    },
    "TerraBlock-macos-aarch64": {
        "type": "executable",
        "target": "macos-aarch64",
        "link-args": [
            "-framework", "Foundation",
            "-framework", "AppKit",
            "-framework", "QuartzCore",
            "-framework", "Metal",
            "-framework", "CoreAudio",
            "-framework", "CoreGraphics",
            "-framework", "IOKit",
            "-framework", "OpenGL"
        ]
    },
    "TerraBlock-macos-x64": {
        "type": "executable",
        "target": "macos-x64",
        "link-args": [
            "-framework", "Foundation",
            "-framework", "AppKit",
            "-framework", "QuartzCore",
            "-framework", "Metal",
            "-framework", "CoreAudio",
            "-framework", "CoreGraphics",
            "-framework", "IOKit",
            "-framework", "OpenGL"
        ]
    },
    "TerraBlock-mingw-x64": {
        "type": "object-files",
        "target": "mingw-x64",
        "cc": "x86_64-w64-mingw32-gcc"
    },
    "TerraBlock-wasm32": {
        "type": "executable",
        "target": "wasm32"
    },
    "TerraBlock-windows-aarch64": {
        "type": "executable",
        "target": "windows-aarch64"
    },
    "TerraBlock-windows-x64": {
        "type": "executable",
        "target": "windows-x64",
        "cc": "clang"
    }
  },
  // Global settings.
  // CPU name, used for optimizations in the LLVM backend.
  "cpu": "generic",
  // Optimization: "O0", "O1", "O2", "O3", "O4", "O5", "Os", "Oz".
  "opt": "Os"
  // See resources/examples/project_all_settings.json and 'c3c --list-project-properties' to see more properties.
}

